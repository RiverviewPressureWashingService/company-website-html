{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-website-html",
  "compatibility_date": "2026-08-05",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/contact"]
  },
  "send_email": [
    { "name": "EMAIL" }
  ]
}